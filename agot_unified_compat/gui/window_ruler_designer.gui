template background_no_edge_bdr {
	background = {
		texture = "gfx/interface/component_tiles/tile_window_background_no_edge.dds"
		spriteType = Corneredtiled
		spriteborder = { 18 0 }
		block "margin" {
			margin = { 0 0 }
		}
		texture_density = 2
		block "alpha" {
			alpha = 0.7
		}

		modify_texture = {
			texture = "gfx/interface/component_overlay/overlay_effect.dds"
			blend_mode = overlay
		}
	}
}

types AGOTCompatRestore {
	
		type button_rd_environment = button_standard {
			layoutpolicy_horizontal = expanding

			onclick = "[GetVariableSystem.SetOrToggle('rd_environment', PdxGuiWidget.GetName )]"
			down = "[GetVariableSystem.HasValue('rd_environment', PdxGuiWidget.GetName )]"
		
			align = left|nobaseline
		
			icon = {
				name = "texture"
				parentanchor = right
				size = { 65% 100% }

				alpha = 0.3
			
				background = {
					block "texture" {}
					using = Mask_Rough_Edges
					fittype = centercrop
				
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_horizontal_thick.dds"
						blend_mode = alphamultiply
						rotate_uv = 3
						mirror = horizontal
					}
				}
			}
		}

	
		type button_rotate_ruler_designer = button {
			texture = "gfx/interface/buttons/button_standard.dds"
			spriteType = Corneredtiled
			spriteborder = { 4 4 }
			framesize = { 252 80 }
			size = { 36 36 }

			button_icon = {
				parentanchor = center
				size = { 20 20 }
				alwaystransparent = yes
			
				block "mirror" {}
				block "texture" {
					texture = "gfx/interface/icons/flat_icons/window_back.dds"
				}
			}
			using = tooltip_ne
		}

	
		type text_ruler_designer_label = text_label_left {
			layoutpolicy_horizontal = expanding
			max_width = 300
			margin_left = 45
			margin_top = 5
			align = nobaseline
			using = Font_Size_Medium
		}
}
