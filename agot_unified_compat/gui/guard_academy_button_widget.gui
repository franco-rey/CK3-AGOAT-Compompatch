widget = {
	name = "guard_academy_button_widget"
	parentanchor = bottom|right
	widgetanchor = bottom|right
	# Standalone layout occupies the normal bottom HUD row.
	position = { -631 -60 }
	size = { 114 36 }
	visible = "[And(And(And(Not(IsPauseMenuShown), GetPlayer.IsValid), IsDefaultGUIMode), GetScriptedGui('agot_guard_positions_standalone_hud_layout').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
	alwaystransparent = no
	layer = hud_layer

	flowcontainer = {
		ignoreinvisible = yes
		parentanchor = bottom|right
		button_round = {
			visible = "[And(And(GetScriptedGui('agot_guard_positions_view_guard_roster_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			name = "agot_guard_roster_button"
			datacontext = "[GetScriptedGui( 'agot_guard_positions_view_guard_roster_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "AGOT_GUARD_POSITIONS_VIEW_GUARD_ROSTER"
			button_icon_highlight = {
				texture = "gfx/interface/icons/flat_icons/kingsguard_flat_black.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 36 36 }
			}
		}
		button_round = {
			visible = "[And(And(GetScriptedGui('agot_guard_positions_view_guard_academy_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			name = "agot_guard_academy_button"
			datacontext = "[GetScriptedGui( 'agot_guard_positions_view_guard_academy_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "AGOT_GUARD_POSITIONS_VIEW_GUARD_ACADEMY"
			button_icon_highlight = {
				texture = "gfx/interface/icons/domicile_building/domicile_building_training_circle.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 25 25 }
				alpha = 0.78
			}
		}
		button_round = {
			visible = "[And(And(GetScriptedGui('agot_guard_positions_view_mission_ledger_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			name = "agot_guard_mission_ledger_button"
			datacontext = "[GetScriptedGui( 'agot_guard_positions_view_mission_ledger_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "AGOT_GUARD_POSITIONS_VIEW_MISSION_LEDGER"
			button_icon_highlight = {
				texture = "gfx/interface/icons/artifact/artifact_chronicle.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 25 25 }
				alpha = 0.52
			}
		}
	}
}
