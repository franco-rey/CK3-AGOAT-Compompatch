	window = {
		name = "naval_combat_compatibility_flagship_builder_window"
		visible = "[And( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('naval_combat_flagship_builder_open').GetValue, '(CFixedPoint)0' ), GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('naval_combat_compatibility_window_open').GetValue, '(CFixedPoint)0' ) )]"
		visible_at_creation = no
		parentanchor = center
		position = { 0 0 }
		size = { 1400 960 }
