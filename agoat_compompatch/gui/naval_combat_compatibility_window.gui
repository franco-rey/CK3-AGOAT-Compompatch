				margin = { 10 8 }
				spacing = 5

				text_single = {
					text = "[SelectLocalization( Or( Not( GetVariableSystem.Exists( 'naval_combat_flagship_slot' ) ), GetVariableSystem.HasValue( 'naval_combat_flagship_slot', 'bow' ) ), 'NAVAL_COMBAT_FLAGSHIP_SLOT_BOW', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_flagship_slot', 'foredeck' ), 'NAVAL_COMBAT_FLAGSHIP_SLOT_DECK', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_flagship_slot', 'center' ), 'NAVAL_COMBAT_FLAGSHIP_SLOT_CENTER', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_flagship_slot', 'aftdeck' ), 'NAVAL_COMBAT_FLAGSHIP_SLOT_AFTDECK', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_flagship_slot', 'stern' ), 'NAVAL_COMBAT_FLAGSHIP_SLOT_STERN', 'NAVAL_COMBAT_FLAGSHIP_SLOT_REINFORCEMENT' ) ) ) ) )]"
					default_format = "#high;bold"
				}

