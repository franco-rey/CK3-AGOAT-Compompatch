types HUD
{
	type naval_combat_compatibility_flagship_fitting_entry = button_standard {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = fixed
		size = { 0 100 }

		block "button" {}

		framesize = { 252 80 }
		spriteType = Corneredtiled
		spriteborder = { 10 10 }

		icon = {
			parentanchor = top|hcenter
			size = { 99% 15% }
			texture = "gfx/interface/illustrations/regional_patterns/mask_pattern_western.dds"
			spriteType = Corneredtiled
			color = { 0.72 0.52 0.24 1 }
			alpha = 0.24
			alwaystransparent = yes
		}

		icon = {
			parentanchor = bottom|hcenter
			size = { 99% 15% }
			texture = "gfx/interface/illustrations/regional_patterns/mask_pattern_western.dds"
			spriteType = Corneredtiled
			mirror = vertical
			color = { 0.72 0.52 0.24 1 }
			alpha = 0.24
			alwaystransparent = yes
		}

		icon = {
			parentanchor = center
			size = { 99% 96% }
			texture = "gfx/interface/component_tiles/tile_vignette_3px.dds"
			spriteType = Corneredtiled
			spriteborder = { 5 5 }
			alpha = 0.72
			alwaystransparent = yes
		}

		hbox = {
			size = { 100% 100% }
			margin = { 8 6 }
			spacing = 8
			alwaystransparent = yes

			widget = {
				size = { 88 88 }
				block "rarity" {
					icon = {
						parentanchor = center
						size = { 88 88 }
						texture = "gfx/interface/icons/artifact/artifact_bg.dds"
						frame = 1
						framesize = { 240 240 }
						alwaystransparent = yes
					}
				}
				block "fitting_icon" {
					icon = {
						parentanchor = center
						size = { 84 84 }
						texture = "gfx/interface/icons/naval_combat/flagship_fittings/flagship_fitting_bow_ram.png"
						alwaystransparent = yes
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed
				size = { 0 72 }
				spacing = 2

				block "name" {
					text_single = {
						layoutpolicy_horizontal = expanding
						default_format = "#high;bold"
					}
				}
				block "description" {
					text_single = {
						layoutpolicy_horizontal = expanding
						default_format = "#low"
					}
				}
			}

			widget = {
				size = { 58 88 }
				hbox = {
					parentanchor = center
					size = { 58 24 }
					spacing = 3
					widget = {
						size = { 18 24 }
						text_single = {
							parentanchor = center
							size = { 18 18 }
							text = "[GetPlayer.GetTreasuryOrGoldPrefix]"
							align = center|nobaseline
						}
					}
					block "price" {
						text_single = {
							size = { 34 24 }
							default_format = "#high"
							align = right|nobaseline
						}
					}
				}
			}
		}
	}
}

	window = {
		name = "naval_combat_compatibility_window"
		visible = "[And( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('naval_combat_compatibility_window_open').GetValue, '(CFixedPoint)0' ), GetPlayer.MakeScope.Var('naval_combat_initialized').IsSet )]"
		visible_at_creation = no
		parentanchor = center
		position = { -30 10 }
		size = { 1180 790 }
		layer = windows_layer

		using = Window_Movable
		using = Window_Background
		using = Window_Decoration_Warfare
		using = Animation_ShowHide_Quick

		vbox = {
			using = Window_Margins
			size = { 100% 100% }
			spacing = 5

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "NAVAL_COMBAT_WINDOW_TITLE"
				}

				blockoverride "button_close"
				{
					onclick = "[GetScriptedGui('naval_combat_close_management_window_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				size = { 0 58 }
				spacing = 8

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { 0 58 }
					background = { using = Background_Area_Dark }
					margin = { 10 5 }
					tooltip = "NAVAL_COMBAT_TOTAL_SHIPS_TT"

					text_single = {
						text = "NAVAL_COMBAT_TOTAL_SHIPS"
						default_format = "#low"
						align = center|nobaseline
					}
					text_single = {
						size = { 86 22 }
						text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_total_ship_count_value')|0]"
						default_format = "#high"
						align = center|nobaseline
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { 0 58 }
					background = { using = Background_Area_Dark }
					margin = { 10 5 }
					tooltip = "NAVAL_COMBAT_CAPACITY_TT"

					text_single = {
						text = "NAVAL_COMBAT_CAPACITY"
						default_format = "#low"
						align = center|nobaseline
					}
					hbox = {

						text_single = {
							size = { 42 22 }
							text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_used_capacity_value')|0]"
							default_format = "#high"
							align = right|nobaseline
						}
						text_single = {
							size = { 12 22 }
							text = "NAVAL_COMBAT_VALUE_SEPARATOR"
							default_format = "#low"
							align = center|nobaseline
						}
						text_single = {
							size = { 42 22 }
							text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_capacity_value')|0]"
							default_format = "#high"
							align = left|nobaseline
						}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { 0 58 }
					background = { using = Background_Area_Dark }
					margin = { 10 5 }
					tooltip = "NAVAL_COMBAT_READINESS_TT"

					text_single = {
						text = "NAVAL_COMBAT_READINESS"
						default_format = "#low"
						align = center|nobaseline
					}
					hbox = {

						text_single = {
							size = { 48 22 }
							text = "[GetPlayer.MakeScope.Var('naval_combat_readiness').GetValue|0]"
							default_format = "#high"
							align = right|nobaseline
						}
						text_single = {
							size = { 16 22 }
							text = "NAVAL_COMBAT_PERCENT"
							default_format = "#low"
							align = left|nobaseline
						}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { 0 58 }
					background = { using = Background_Area_Dark }
					margin = { 10 5 }
					tooltip = "NAVAL_COMBAT_DRILL_TT"

					text_single = {
						text = "NAVAL_COMBAT_DRILL"
						default_format = "#low"
						align = center|nobaseline
					}
					hbox = {

						text_single = {
							size = { 48 22 }
							text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_drill_value')|0]"
							default_format = "#high"
							align = right|nobaseline
						}
						text_single = {
							size = { 16 22 }
							text = "NAVAL_COMBAT_PERCENT"
							default_format = "#low"
							align = left|nobaseline
						}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { 0 58 }
					background = { using = Background_Area_Dark }
					margin = { 10 5 }
					tooltip = "NAVAL_COMBAT_MAINTENANCE_TT"

					text_single = {
						text = "NAVAL_COMBAT_MAINTENANCE"
						default_format = "#low"
						align = center|nobaseline
					}
					hbox = {

						text_single = {
							text = "[GetPlayer.GetTreasuryOrGoldPrefix]"
							size = { 18 18 }
							align = center|nobaseline
						}
						text_single = {
							size = { 68 22 }
							text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_monthly_maintenance_value')|2]"
							default_format = "#high"
							align = left|nobaseline
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed
				size = { 0 460 }
				spacing = 12

				vbox = {
					layoutpolicy_horizontal = fixed
					layoutpolicy_vertical = fixed
					size = { 300 460 }
					spacing = 4

					text_single = { text = "NAVAL_COMBAT_NAVAL_MINISTER" default_format = "#high;bold" }

					widget = {
						size = { 300 205 }
						tooltip = "NAVAL_COMBAT_NAVAL_MINISTER_TT"

						icon = {
							size = { 300 205 }
							texture = "gfx/interface/skinned/illustrations/council/bg_council_marshal.dds"
							using = Mask_Rough_Edges
						}

						icon = {
							size = { 300 205 }
							texture = "gfx/interface/colors/white.dds"
							color = { 0.02 0.02 0.02 0.42 }
							using = Mask_Rough_Edges
						}

						vbox = {
							size = { 100% 100% }
							margin = { 12 8 }
							text_single = { text = "NAVAL_COMBAT_NAVAL_MINISTER_OFFICE" default_format = "#high;bold" align = center|nobaseline }

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 10

								button = {
									visible = "[Not( GetPlayer.GetCharacterEmployedAs('naval_minister_court_position').IsValid )]"
									align = center
									size = { 108 149 }
									texture = "gfx/portraits/unknown_portraits/button_unknown_small.dds"
									framesize = { 564 780 }
									gfxtype = framedbuttongfx
									upframe = 1
									overframe = 2
									effectname = "NoHighlight"
									onclick = "[GetCourtPositionType('naval_minister_court_position').OpenAppointWindow(GetPlayer.Self)]"
									tooltip = "NAVAL_COMBAT_NAVAL_MINISTER_APPOINT_TT"

									button_icon = {
										parentanchor = center
										position = { 0 44 }
										size = { 40 40 }
										alwaystransparent = yes
										texture = "gfx/interface/icons/flat_icons/plus.dds"
									}
								}

								widget = {
									visible = "[GetPlayer.GetCharacterEmployedAs('naval_minister_court_position').IsValid]"
									datacontext = "[GetPlayer.GetCharacterEmployedAs('naval_minister_court_position')]"

									size = { 108 149 }
									allow_outside = yes

									portrait_button = {
										parentanchor = center
										size = { 132 158 }
										using = portrait_base
										portrait_texture = "[Character.GetAnimatedPortrait('environment_council', 'camera_council', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
										mask = "gfx/portraits/portrait_mask_council.dds"
										effectname = "NoHighlight"
									}
								}

								vbox = {
									layoutpolicy_horizontal = expanding

									spacing = 5
									text_single = {
										visible = "[Not( GetPlayer.GetCharacterEmployedAs('naval_minister_court_position').IsValid )]"
										text = "NAVAL_COMBAT_NAVAL_MINISTER_VACANT"
										default_format = "#high;bold"
									}
									text_multi = {
										visible = "[Not( GetPlayer.GetCharacterEmployedAs('naval_minister_court_position').IsValid )]"
										layoutpolicy_horizontal = expanding
										text = "NAVAL_COMBAT_NAVAL_MINISTER_VACANT_DESC"
										default_format = "#low;italic"
									}
									text_single = {
										visible = "[GetPlayer.GetCharacterEmployedAs('naval_minister_court_position').IsValid]"
										datacontext = "[GetPlayer.GetCharacterEmployedAs('naval_minister_court_position')]"
										text = "NAVAL_COMBAT_NAVAL_MINISTER_APPOINTED"
										default_format = "#low"
									}
								}
							}
						}
					}

					text_single = { text = "NAVAL_COMBAT_FLEET_ORDERS" default_format = "#high;bold" }

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 5

						vbox = {
							layoutpolicy_horizontal = expanding
							size = { 0 88 }
							background = { using = Background_Area_Dark }
							margin = { 10 6 }
							spacing = 3
							hbox = {
								layoutpolicy_horizontal = expanding
								button_checkbox_label = {
									size = { 156 28 }
									onclick = "[GetScriptedGui('naval_combat_toggle_transport_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									enabled = "[GetScriptedGui('naval_combat_toggle_transport_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									tooltip = "NAVAL_COMBAT_TRANSPORT_ORDER_TT"
									blockoverride "checkbox" { checked = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('naval_combat_transport_active').GetValue, '(CFixedPoint)0' )]" }
									blockoverride "text" { text = "NAVAL_COMBAT_TRANSPORT_ORDER" }
								}
								expand = {}
								text_single = { size = { 38 22 } text = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP" default_format = "#low" tooltip = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP_TT" align = right|nobaseline }
								text_single = { size = { 16 16 } text = "[GetPlayer.GetTreasuryOrGoldPrefix]" tooltip = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP_TT" align = center|nobaseline }
								text_single = { size = { 52 22 } text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_transport_order_extra_maintenance_value')|2]" default_format = "#high" tooltip = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP_TT" align = left|nobaseline }
							}
							divider = { layoutpolicy_horizontal = expanding }
							text_single = { layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed size = { 280 18 } text = "NAVAL_COMBAT_TRANSPORT_COVERAGE_COMPACT" default_format = "#low" tooltip = "NAVAL_COMBAT_TRANSPORT_COVERAGE_TT" }
							text_single = { layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed size = { 280 18 } text = "NAVAL_COMBAT_TRANSPORT_BONUS_INLINE" default_format = "#high" tooltip = "NAVAL_COMBAT_TRANSPORT_BONUS_TT" }
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							size = { 0 64 }
							background = { using = Background_Area_Dark }
							margin = { 10 6 }
							spacing = 3
							hbox = {
								layoutpolicy_horizontal = expanding
								button_checkbox_label = {
									size = { 156 28 }
									onclick = "[GetScriptedGui('naval_combat_toggle_sea_control_gui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									enabled = "[GetScriptedGui('naval_combat_toggle_sea_control_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									tooltip = "NAVAL_COMBAT_SEA_CONTROL_ORDER_TT"
									blockoverride "checkbox" { checked = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('naval_combat_sea_control_active').GetValue, '(CFixedPoint)0' )]" }
									blockoverride "text" { text = "NAVAL_COMBAT_SEA_CONTROL_ORDER" }
								}
								expand = {}
								text_single = { size = { 38 22 } text = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP" default_format = "#low" tooltip = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP_TT" align = right|nobaseline }
								text_single = { size = { 16 16 } text = "[GetPlayer.GetTreasuryOrGoldPrefix]" tooltip = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP_TT" align = center|nobaseline }
								text_single = { size = { 52 22 } text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_sea_control_order_extra_maintenance_value')|2]" default_format = "#high" tooltip = "NAVAL_COMBAT_ORDER_EXTRA_UPKEEP_TT" align = left|nobaseline }
							}
							divider = { layoutpolicy_horizontal = expanding }
							text_single = { layoutpolicy_horizontal = fixed layoutpolicy_vertical = fixed size = { 280 18 } text = "NAVAL_COMBAT_SEA_CONTROL_SUMMARY" default_format = "#low" tooltip = "NAVAL_COMBAT_SEA_CONTROL_ORDER_TT" }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							size = { 0 36 }
							background = { using = Background_Area_Dark }
							margin = { 10 6 }
							tooltip = "NAVAL_COMBAT_MAINTENANCE_TT"
							text_single = { text = "NAVAL_COMBAT_CURRENT_MONTHLY_UPKEEP" default_format = "#low" }
							expand = {}
							icon = { texture = "gfx/interface/icons/map_icons/naval_transportation.dds" size = { 22 22 } }
							text_single = { size = { 16 16 } text = "[GetPlayer.GetTreasuryOrGoldPrefix]" align = center|nobaseline }
							text_single = { size = { 62 22 } text = "[GetPlayer.MakeScope.ScriptValue('naval_combat_monthly_maintenance_value')|2]" default_format = "#high" align = left|nobaseline }
						}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = fixed
					size = { 0 460 }
					spacing = 4

					text_single = {
						text = "NAVAL_COMBAT_SHIP_DETAILS"
						default_format = "#high;bold"
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						background = { using = Background_Area_Dark }
						margin = { 12 10 }
						spacing = 7

						widget = {
							layoutpolicy_horizontal = expanding
							size = { 0 240 }

							icon = {
								parentanchor = center
								size = { 480 240 }
								texture = "gfx/interface/illustrations/naval_combat/transport_ship.png"
								visible = "[Or( Not( GetVariableSystem.Exists( 'naval_combat_ship_detail' ) ), GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'transport' ) )]"
								using = Mask_Rough_Edges
							}
							icon = {
								parentanchor = center
								size = { 480 240 }
								texture = "gfx/interface/illustrations/naval_combat/oared_warship.png"
								visible = "[GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'oared' )]"
								using = Mask_Rough_Edges
							}
							icon = {
								parentanchor = center
								size = { 480 240 }
								texture = "gfx/interface/illustrations/naval_combat/high_sided_warship.png"
								visible = "[GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'high_sided' )]"
								using = Mask_Rough_Edges
							}
							icon = {
								parentanchor = center
								size = { 480 240 }
								texture = "gfx/interface/illustrations/naval_combat/longship.png"
								visible = "[GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'longship' )]"
								using = Mask_Rough_Edges
							}
							icon = {
								parentanchor = center
								size = { 480 240 }
								texture = "gfx/interface/illustrations/naval_combat/greek_fire_ship.png"
								visible = "[GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'greek_fire' )]"
								using = Mask_Rough_Edges
							}
							icon = {
								parentanchor = center
								size = { 480 240 }
								texture = "gfx/interface/illustrations/naval_combat/tower_ship.png"
								visible = "[GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'tower_ship' )]"
								using = Mask_Rough_Edges
							}
							icon = {
								parentanchor = center
								size = { 480 240 }
								texture = "gfx/interface/illustrations/naval_combat/flagship.png"
								visible = "[GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'flagship' )]"
								using = Mask_Rough_Edges
							}
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = fixed
							size = { 0 160 }
							spacing = 6

							text_single = {
								layoutpolicy_vertical = fixed
								size = { 0 20 }
								text = "[SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'flagship' ), 'NAVAL_COMBAT_FLAGSHIP_DETAIL_TITLE', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'longship' ), 'NAVAL_COMBAT_LONGSHIP_DETAIL_TITLE', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'greek_fire' ), 'NAVAL_COMBAT_GREEK_FIRE_SHIP_DETAIL_TITLE', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'tower_ship' ), 'NAVAL_COMBAT_TOWER_SHIP_DETAIL_TITLE', SelectLocalization( Or( Not( GetVariableSystem.Exists( 'naval_combat_ship_detail' ) ), GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'transport' ) ), 'NAVAL_COMBAT_TRANSPORT_SHIP_DETAIL_TITLE', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'oared' ), 'NAVAL_COMBAT_OARED_WARSHIP_DETAIL_TITLE', 'NAVAL_COMBAT_HIGH_SIDED_WARSHIP_DETAIL_TITLE' ) ) ) ) ) )]"
								default_format = "#high;bold"
							}
							text_multi = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = fixed
								size = { 0 32 }
								text = "[SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'flagship' ), 'NAVAL_COMBAT_FLAGSHIP_DETAIL_DESC', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'longship' ), 'NAVAL_COMBAT_LONGSHIP_DETAIL_DESC', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'greek_fire' ), 'NAVAL_COMBAT_GREEK_FIRE_SHIP_DETAIL_DESC', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'tower_ship' ), 'NAVAL_COMBAT_TOWER_SHIP_DETAIL_DESC', SelectLocalization( Or( Not( GetVariableSystem.Exists( 'naval_combat_ship_detail' ) ), GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'transport' ) ), 'NAVAL_COMBAT_TRANSPORT_SHIP_DETAIL_DESC', SelectLocalization( GetVariableSystem.HasValue( 'naval_combat_ship_detail', 'oared' ), 'NAVAL_COMBAT_OARED_WARSHIP_DETAIL_DESC', 'NAVAL_COMBAT_HIGH_SIDED_WARSHIP_DETAIL_DESC' ) ) ) ) ) )]"
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = fixed
								size = { 0 96 }
								spacing = 2
								tooltip = "NAVAL_COMBAT_SHIP_STATS_TT"

								vbox = {

									size = { 495 46 }
									spacing = 0

