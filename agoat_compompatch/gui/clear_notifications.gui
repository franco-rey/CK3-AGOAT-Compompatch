
types Notifications {

	type notifications_message_feed = flowcontainer {
		name = "message_feed_widget"
		visible = "[And(And( Not(SinglePlayerShowingPausedSuccession), IsDefaultGUIMode), Not(IsPauseMenuShown))]"
		parentanchor = bottom|right
		alwaystransparent = yes
		ignoreinvisible = yes
		margin_right = -15
		margin_bottom = 10
		allow_outside = yes

		using = Animation_ShowHide_Quick

		flowcontainer = {
			ignoreinvisible = yes
			visible = "[Not(IsObserver)]"

			flowcontainer = {
				visible = "[Not(GetScriptedGui('hide_all_notifications').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End ))]"
				ignoreinvisible = yes

				container = { # when pinned, moves them away from the screen
					ignoreinvisible = yes
					visible = "[GetScriptedGui('hide_notifications_windows').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"

					container = {
						name = "push_right"

						state = {
							name = push_right
							on_start = "[PdxGuiWidget.AccessParent.AccessParent.FindChild('messages').Hide]"
							trigger_when = "[IsRightWindowOpen]"
						}

						state = {
							name = unpush_right
							on_start = "[PdxGuiWidget.AccessParent.AccessParent.FindChild('messages').Show]"
							trigger_when = "[Not(IsRightWindowOpen)]"
						}
					}
				}

				flowcontainer = {
					direction = vertical
					ignoreinvisible = yes
					name = "messages"

					flowcontainer = {
						ignoreinvisible = yes

						widget = {
							size = { 450 0 }

							state = {
								name = _show
								using = Animation_FadeIn_Standard
							}

							state = {
								name = _hide
								using = Animation_FadeOut_Quick
							}

							vbox = {
								name = "message_feed"
								datamodel = "[MessageFeedHandler.GetItems]"
								set_parent_size_to_minimum = yes

								expand = { }

								item = {
									vbox = {
										layoutpolicy_vertical = growing
										layoutpolicy_horizontal = expanding
										datacontext = "[FeedMessageItem.GetPlayerMessageItem]"
										spacing = 2
										alwaystransparent = no
										filter_mouse = all

										state = {
											name = "mark_to_delete"
											trigger_when = "[FeedMessageItem.IsSetToDelete]"
											on_start = "[FeedMessageItem.StartAnimation]"
											on_finish = "[FeedMessageItem.EndAnimation]"
											on_finish = "[FeedMessageItem.Delete]"
											duration = 0.3
											alpha = 0
											using = Animation_Curve_Default
										}

										background = {
											using = Background_Area_Dark
										}

										button = {
											name = "header"
											layoutpolicy_horizontal = expanding
											size = { 0 32 }
											onclick = "[FeedMessageItem.Expand]"
											onrightclick = "[FeedMessageItem.MarkToDelete]"
											button_ignore = none
											tooltip = "MESSAGE_CLICK_TOOLTIP"

											using = situation_entry_parent_hover_states

											state = {
												name = _mouse_hierarchy_enter
												on_start = "[PdxGuiWidget.FindChild('button_dismiss_all').TriggerAnimation('hover_enter')]"
											}

											state = {
												name = _mouse_hierarchy_leave
												on_start = "[PdxGuiWidget.FindChild('button_dismiss_all').TriggerAnimation('hover_leave')]"
											}

											background = {
												name = "neutral"
												visible = "[PlayerMessageItem.GetType.IsNeutral]"
												using = Feed_Message_Header
											}

											background = {
												name = "good"
												visible = "[PlayerMessageItem.GetType.IsGood]"
												using = Feed_Message_Header
												tintcolor = { 0.767708 0.78125 0.3479 0.847656 }
											}

											background = {
												name = "bad"
												visible = "[PlayerMessageItem.GetType.IsBad]"
												using = Feed_Message_Header
												tintcolor = { 0.949219 0.446105 0.330002 0.847656 }
											}

											hbox = {
												margin_right = 10
												margin_left = 5
												spacing = 5

												layoutpolicy_horizontal = expanding

												icon = {
													name = "message_type"
													size = { 28 28 }
													texture = "[PlayerMessageItem.GetType.GetIcon]"
													tooltip = "[PlayerMessageItem.GetTooltip]"
													using = tooltip_ws
												}

												text_single = {
													name = "title"
													text = "[PlayerMessageItem.GetTitle]"
													using = Font_Size_Medium
													align = nobaseline
													max_width = 355
													fontsize_min = 14
												}

												expand = {}

												flowcontainer = {
													name = "button_dismiss"
													allow_outside = yes

													alpha = 1

													state = {
														name = hover_enter
														alpha = 0
														duration = 0.05
														using = Animation_Curve_Default
													}

													state = {
														name = hover_leave
														alpha = 1
														duration = 0.2
														using = Animation_Curve_Default
													}

													### MESSAGE DELIVERED DATE
													widget = {
														allow_outside = yes

														text_single = {
															name = "date"
															margin_left = 16
															parentanchor = vcenter|left

															text = "[PlayerMessageItem.GetArrivalDate.GetStringShortNoYear]"
															align = nobaseline
														}
													}
												}

												flowcontainer = {
													name = "button_dismiss_all"
													alpha = 0

													state = {
														name = hover_enter
														alpha = 1
														duration = 0.05
														using = Animation_Curve_Default
													}

													state = {
														name = hover_leave
														alpha = 0
														duration = 0.2
														using = Animation_Curve_Default
													}

													### MESSAGE SETTINGS SHORTCUT
													widget = {
														size = { 26 26 }

														allow_outside = yes

														button_menu = {
															size = { 26 26 }

															button_ignore = none

															onclick = "[ToggleGameViewData('message_settings', FeedMessageItem.GetPlayerMessageItem.GetType)]"
															tooltip = "MESSAGE_SETTINGS_WINDOW_SHORTCUT_TT"
															using = tooltip_se
														}
													}

													### MARK MESSAGE FOR DELETE
													widget = {
														size = { 26 26 }

														allow_outside = yes

														button_clear = {
															size = { 26 26 }

															button_ignore = none

															onrightclick = "[MessageFeedHandler.MarkAllForDelete]"
															onclick = "[FeedMessageItem.MarkToDelete]"
															tooltip = "MESSAGE_CLEAR_ALL_TOOLTIP"
															using = tooltip_se
														}
													}
												}
											}
										}

										widget = {
											name = "message_feed_text_area"
											layoutpolicy_horizontal = expanding
											size = { 450 0 }
											scissor = yes

											state = {
												name = "hide_text_1"
												next = "hide_text_2"
												trigger_when = "[FeedMessageItem.ShouldHide]"
												duration = 0
												size = { 450 180 }
											}

											state = {
												name = "hide_text_2"
												on_start = "[FeedMessageItem.StartAnimation]"
												on_finish = "[FeedMessageItem.EndAnimation]"
												on_finish = "[FeedMessageItem.ClickedHideFinished]"
												size = { 450 0 }
												using = Animation_FadeOut_Quick
												duration = 0
											}

											state = {
												name = "hide_text_clicked"
												trigger_when = "[FeedMessageItem.ClickedHide]"
												on_start = "[FeedMessageItem.StartAnimation]"
												on_finish = "[FeedMessageItem.EndAnimation]"
												on_finish = "[FeedMessageItem.ClickedHideFinished]"
												size = { 450 0 }
												using = Animation_FadeOut_Quick
												duration = 0.15
											}

											state = {
												name = "show_text_hidden"
												trigger_when = "[Not(FeedMessageItem.IsExpanded)]"
												duration = 0.15
												size = { 450 0 }
											}

											state = {
												name = "show_text_clicked"
												trigger_when = "[FeedMessageItem.ClickedExpand]"
												on_start = "[FeedMessageItem.StartAnimation]"
												on_finish = "[FeedMessageItem.EndAnimation]"
												on_finish = "[FeedMessageItem.ClickedExpandFinished]"
												size = { 450 180 }
												using = Animation_FadeIn_Standard
												duration = 0.15
											}

											state = {
												name = "show_text"
												trigger_when = "[FeedMessageItem.ShouldShow]"
												on_start = "[FeedMessageItem.StartAnimation]"
												on_finish = "[FeedMessageItem.EndAnimation]"
												on_finish = "[FeedMessageItem.ClickedExpandFinished]"
												size = { 450 180 }
												using = Animation_FadeIn_Standard
												duration = 0.2
											}

											state = {
												name = "show_text_expanded"
												trigger_when = "[FeedMessageItem.IsExpanded]"
												duration = 0
												size = { 450 180 }
											}

											hbox = {
												name = "text_and_icons"
												margin_right = 10

												state = {
													name = appear
													using = Animation_FadeIn_Quick
													trigger_when = "[Or(FeedMessageItem.ClickedExpand, FeedMessageItem.ShouldShow)]"
												}

												state = {
													name = disappear
													using = Animation_FadeOut_Quick
													trigger_when = "[FeedMessageItem.ShouldHide]"
												}

												text_multi = {
													name = "text"
													layoutpolicy_vertical = expanding
													layoutpolicy_horizontal = expanding

													margin = { 20 10 }
													text = "[PlayerMessageItem.GetDescription]"
													elide = right
												}

												vbox = {
													layoutpolicy_vertical = expanding
													margin_top = 5
													margin_bottom = 15

													hbox = {
														portrait_head_small = {
															name = "portrait_left"
															datacontext = "[PlayerMessageItem.GetLeftCharacter]"
															visible = "[Character.IsValid]"
														}

														coa_title_medium = {
															name = "title_left"
															datacontext = "[PlayerMessageItem.GetLeftTitle]"
															visible = "[Title.IsValid]"
														}

														icon_artifact = {
															name = "artifact_left"
															datacontext = "[PlayerMessageItem.GetLeftArtifact]"
															visible = "[Artifact.IsValid]"
														}

														portrait_head_small = {
															name = "portrait_right"
															datacontext = "[PlayerMessageItem.GetRightCharacter]"
															visible = "[Character.IsValid]"
														}

														coa_title_medium = {
															name = "title_right"
															datacontext = "[PlayerMessageItem.GetRightTitle]"
															visible = "[Title.IsValid]"
														}

														icon_artifact = {
															name = "artifact_right"
															datacontext = "[PlayerMessageItem.GetRightArtifact]"
															visible = "[Artifact.IsValid]"
														}
													}

													expand = { }
												}
											}
										}
									}
								}
							}
						}

						widget = {
							parentanchor = bottom
							size = { 35 100% }
							minimumsize = { 35 70 }
							maximumsize = { 35 305 }
							visible = "[And(GetScriptedGui('right_clear_notifications').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End ), Not(IsDataModelEmpty(AccessMessageFeedHandler.GetItems)))]"
							vbox = {

								button = {
									layoutpolicy_vertical = expanding
									size = { 35 35 }
									background = {
										using = Background_Area_Dark
										alpha = 0.7
									}
									#right-side clear

									alwaystransparent = no

									shortcut = "army_split_half"
									onclick = "[MessageFeedHandler.MarkAllForDelete]"
									onrightclick = "[MessageFeedHandler.MarkAllForDelete]"
									button_ignore = none

									button_clear = {
										alwaystransparent = yes
										parentanchor = vcenter
										position = { 1 -2 }
									}
								}

								button = {
									size = { 35 35 }
									onclick = "[GetVariableSystem.Toggle('clear_notification_settings')]"
									background = {
										using = Background_Area_Dark
										alpha = 0.7
									}
									button_menu = {
										position = { -1 0 }
										alwaystransparent = yes
										parentanchor = center
									}
								}
							}
						}


						widget = {
							size = { 5 0 }
							visible = "[Not(GetScriptedGui('right_clear_notifications').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End ))]"
						}
					}
					flowcontainer = {
						visible = "[GetVariableSystem.Exists('clear_notification_settings')]"
						margin = { 5 5 }
						background = {
							using = Background_Area_Dark
						}

						flowcontainer = {
							direction = vertical
							spacing = 5

							button = {
								size = { 410 30 }
								button_checkbox_label = {
									onclick = "[GetScriptedGui('hide_notifications_windows').Execute( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"
									blockoverride "text" {
										text = "pin_notifs_text"
										tooltip = "pin_notifs"
									}
									blockoverride "checkbox" {
										checked = "[GetScriptedGui('hide_notifications_windows').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"
									}
								}
							}
							button = {
								size = { 410 30 }
								button_checkbox_label = {
									onclick = "[GetScriptedGui('right_clear_notifications').Execute( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"
									blockoverride "text" {
										text = "right_side_notifs"
									}
									blockoverride "checkbox" {
										alwaystransparent = yes
										checked = "[GetScriptedGui('right_clear_notifications').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"
									}
								}
							}
							button = {
								size = { 410 30 }
								button_checkbox_label = {
									onclick = "[GetScriptedGui('hide_all_notifications').Execute( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"
									onclick = "[GetVariableSystem.Clear('clear_notification_settings')]"
									blockoverride "text" {
										text = "hide_all_notifications"
									}
									blockoverride "checkbox" {
										alwaystransparent = yes
										checked = "[GetScriptedGui('hide_all_notifications').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"
									}
								}
							}
						}

						button = {
							size = { 30 100% }
							onclick = "[GetVariableSystem.Toggle('clear_notification_settings')]"
							button_close = {
								alwaystransparent = yes
								size = { 20 20 }
								parentanchor = center
							}
						}

					}


					flowcontainer = {
						#bottom clear
						visible = "[And(Not(GetScriptedGui('right_clear_notifications').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )), Not(IsDataModelEmpty(AccessMessageFeedHandler.GetItems)))]"
						ignoreinvisible = yes
						alpha = 0.9

						button = {
							size = { 410 33 }
							onclick = "[MessageFeedHandler.MarkAllForDelete]"
							onrightclick = "[MessageFeedHandler.MarkAllForDelete]"
							button_ignore = none
							shortcut = "army_split_half"

							text_single = {
								text = "clear_notifs"
								default_format = "#clickable"
								position = { 45 -2 }
								parentanchor = vcenter
							}

							background = {
								using = Background_Area_Dark
							}

							button_clear = {
								parentanchor = vcenter
								position = { 5 0 }
								alwaystransparent = yes
							}
						}

						button = {
							size = { 40 30 }
							onclick = "[GetVariableSystem.Toggle('clear_notification_settings')]"

							background = {
								using = Background_Area_Dark
							}

							button_menu = {
								alwaystransparent = yes
								parentanchor = center
							}
							#
							# button = {
							# 	size = { 0 0 }
							# 	visible = "[GetVariableSystem.Exists('clear_notification_settings')]"
							# 	shortcut = "close_window"
							# 	onclick = "[GetVariableSystem.Toggle('clear_notification_settings')]"
							# }
						}
					}

					widget = {
						name = "push_up"
						size = { 0 70 }

						visible = "[Not(IsRightWindowOpen)]"
					}
				}

				container = {
					ignoreinvisible = yes

					visible = "[Not(GetScriptedGui('hide_notifications_windows').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End ))]"

					widget = {
						name = "push_left"
						size = { 630 0 }
						visible = "[IsRightWindowOpen]"
					}
				}
			}

			button = {
				size = { 35 200 }
				alpha = 0.5
				onclick = "[GetScriptedGui('hide_all_notifications').Execute( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"
				visible = "[GetScriptedGui('hide_all_notifications').IsShown( GuiScope.AddScope( 'agoat_player', GetPlayer.MakeScope ).End )]"

				state = {
					name = _mouse_enter
					alpha = 1
				}

				state = {
					name =_mouse_leave
					alpha = 0.5
				}

				button_icon = {
					size = { 20 30 }
					texture = "gfx/interface/icons/flat_icons/button_list_arrow.dds"
					parentanchor = center
					mirror = horizontal
					alwaystransparent = yes
				}
			}
		}
	}
}

