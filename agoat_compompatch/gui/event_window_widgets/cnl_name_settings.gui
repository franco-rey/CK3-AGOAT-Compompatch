
vbox = {
	name = "cnl_name_settings"
	layoutpolicy_horizontal = expanding
	minimumsize = { 0 360 }
	ignoreinvisible = yes
	spacing = 5
	margin = { 5 0 }

	datacontext = "[EventWindowWidget.GetScope.sC('cnl_records_owner')]"


	hbox = {
		visible = "[Not( Character.MakeScope.Var( 'cnl_view_house' ).IsSet )]"
		layoutpolicy_horizontal = expanding

		ignoreinvisible = yes
		spacing = 10

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3

			text_label_center = {
				layoutpolicy_horizontal = expanding
				max_width = 205
				text = "cnl_name_records_male"
			}

			scrollbox = {
				size = { 215 150 }
				layoutpolicy_horizontal = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "cnl_settings_dynasty_male"
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						datamodel = "[Character.GetDynasty.MakeScope.GetList( 'cnl_historical_names_male' )]"

						item = {
							hbox = {
								visible = "[Scope.Char.IsValid]"
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes
								spacing = 3

								text_single = {
									layoutpolicy_horizontal = expanding
									align = nobaseline|left
									max_width = 110
									text = "[Localize( Scope.Char.GetFirstNameBase )]"
								}

								button_minus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_down' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								text_single = {
									align = nobaseline|center
									max_width = 28
									raw_text = "[Scope.Char.MakeScope.Var( 'cnl_weight' ).GetValue|0]"
								}

								button_plus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_up' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								button_dismiss = {
									tooltip = "cnl_remove_name_tooltip"
									onclick = "[GetScriptedGui( 'cnl_remove_historical_name' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}
							}
						}
					}
				}

				blockoverride "scrollbox_empty"
				{
					visible = "[IsDataModelEmpty( Character.GetDynasty.MakeScope.GetList( 'cnl_historical_names_male' ) )]"
					max_width = 195
					text = "cnl_name_records_empty"
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3

			text_label_center = {
				layoutpolicy_horizontal = expanding
				max_width = 205
				text = "cnl_name_records_female"
			}

			scrollbox = {
				size = { 215 150 }
				layoutpolicy_horizontal = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "cnl_settings_dynasty_female"
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						datamodel = "[Character.GetDynasty.MakeScope.GetList( 'cnl_historical_names_female' )]"

						item = {
							hbox = {
								visible = "[Scope.Char.IsValid]"
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes
								spacing = 3

								text_single = {
									layoutpolicy_horizontal = expanding
									align = nobaseline|left
									max_width = 110
									text = "[Localize( Scope.Char.GetFirstNameBase )]"
								}

								button_minus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_down' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								text_single = {
									align = nobaseline|center
									max_width = 28
									raw_text = "[Scope.Char.MakeScope.Var( 'cnl_weight' ).GetValue|0]"
								}

								button_plus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_up' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								button_dismiss = {
									tooltip = "cnl_remove_name_tooltip"
									onclick = "[GetScriptedGui( 'cnl_remove_historical_name' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}
							}
						}
					}
				}

				blockoverride "scrollbox_empty"
				{
					visible = "[IsDataModelEmpty( Character.GetDynasty.MakeScope.GetList( 'cnl_historical_names_female' ) )]"
					max_width = 195
					text = "cnl_name_records_empty"
				}
			}
		}
	}


	hbox = {
		visible = "[Character.MakeScope.Var( 'cnl_view_house' ).IsSet]"
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		spacing = 10

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3

			text_label_center = {
				layoutpolicy_horizontal = expanding
				max_width = 205
				text = "cnl_name_records_male"
			}

			scrollbox = {
				size = { 215 150 }
				layoutpolicy_horizontal = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "cnl_settings_house_male"
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						datamodel = "[Character.GetHouse.MakeScope.GetList( 'cnl_historical_names_male' )]"

						item = {
							hbox = {
								visible = "[Scope.Char.IsValid]"
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes
								spacing = 3

								text_single = {
									layoutpolicy_horizontal = expanding
									align = nobaseline|left
									max_width = 110
									text = "[Localize( Scope.Char.GetFirstNameBase )]"
								}

								button_minus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_down' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								text_single = {
									align = nobaseline|center
									max_width = 28
									raw_text = "[Scope.Char.MakeScope.Var( 'cnl_weight' ).GetValue|0]"
								}

								button_plus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_up' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								button_dismiss = {
									tooltip = "cnl_remove_name_tooltip"
									onclick = "[GetScriptedGui( 'cnl_remove_historical_name' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}
							}
						}
					}
				}

				blockoverride "scrollbox_empty"
				{
					visible = "[IsDataModelEmpty( Character.GetHouse.MakeScope.GetList( 'cnl_historical_names_male' ) )]"
					max_width = 195
					text = "cnl_name_records_empty"
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3

			text_label_center = {
				layoutpolicy_horizontal = expanding
				max_width = 205
				text = "cnl_name_records_female"
			}

			scrollbox = {
				size = { 215 150 }
				layoutpolicy_horizontal = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "cnl_settings_house_female"
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						datamodel = "[Character.GetHouse.MakeScope.GetList( 'cnl_historical_names_female' )]"

						item = {
							hbox = {
								visible = "[Scope.Char.IsValid]"
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes
								spacing = 3

								text_single = {
									layoutpolicy_horizontal = expanding
									align = nobaseline|left
									max_width = 110
									text = "[Localize( Scope.Char.GetFirstNameBase )]"
								}

								button_minus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_down' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								text_single = {
									align = nobaseline|center
									max_width = 28
									raw_text = "[Scope.Char.MakeScope.Var( 'cnl_weight' ).GetValue|0]"
								}

								button_plus_small = {
									tooltip = "cnl_weight_tooltip"
									onclick = "[GetScriptedGui( 'cnl_weight_up' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}

								button_dismiss = {
									tooltip = "cnl_remove_name_tooltip"
									onclick = "[GetScriptedGui( 'cnl_remove_historical_name' ).Execute( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'entry', Scope.Char.MakeScope ).End )]"
								}
							}
						}
					}
				}

				blockoverride "scrollbox_empty"
				{
					visible = "[IsDataModelEmpty( Character.GetHouse.MakeScope.GetList( 'cnl_historical_names_female' ) )]"
					max_width = 195
					text = "cnl_name_records_empty"
				}
			}
		}
	}

	divider_light = {
		layoutpolicy_horizontal = expanding
	}


	hbox = {
		layoutpolicy_horizontal = expanding
		spacing = 5

		text_single = {
			align = nobaseline|left
			max_width = 250
			text = "cnl_newborn_chance_label"
			tooltip = "cnl_newborn_chance_tooltip"
		}

		expand = {}

		button_minus_small = {
			tooltip = "cnl_newborn_chance_tooltip"
			onclick = "[GetScriptedGui( 'cnl_newborn_chance_down' ).Execute( GuiScope.SetRoot( Character.MakeScope ).End )]"
		}

		text_single = {
			align = nobaseline|center
			max_width = 50
			raw_text = "[Character.GetDynasty.MakeScope.Var( 'cnl_newborn_name_chance' ).GetValue|0]%"
		}

		button_plus_small = {
			tooltip = "cnl_newborn_chance_tooltip"
			onclick = "[GetScriptedGui( 'cnl_newborn_chance_up' ).Execute( GuiScope.SetRoot( Character.MakeScope ).End )]"
		}
	}


	hbox = {
		visible = "[Character.GetHouse.IsValid]"
		layoutpolicy_horizontal = expanding
		spacing = 5

		text_single = {
			align = nobaseline|left
			max_width = 250
			text = "cnl_house_share_label"
			tooltip = "cnl_house_share_tooltip"
		}

		expand = {}

		button_minus_small = {
			tooltip = "cnl_house_share_tooltip"
			onclick = "[GetScriptedGui( 'cnl_house_chance_down' ).Execute( GuiScope.SetRoot( Character.MakeScope ).End )]"
		}

		text_single = {
			align = nobaseline|center
			max_width = 50
			raw_text = "[Character.GetHouse.MakeScope.Var( 'cnl_house_name_chance' ).GetValue|0]%"
		}

		button_plus_small = {
			tooltip = "cnl_house_share_tooltip"
			onclick = "[GetScriptedGui( 'cnl_house_chance_up' ).Execute( GuiScope.SetRoot( Character.MakeScope ).End )]"
		}
	}

	divider_light = {
		layoutpolicy_horizontal = expanding
	}

	expand = {}
}
